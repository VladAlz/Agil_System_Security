# ─── Ocelot API Gateway — puerto 5000 ────────────────────────────────────────
# Todo el tráfico pasa por el Gateway. NO apuntes directamente a los microservicios.
#
# En emulador Android usar 10.0.2.2 para alcanzar localhost del host.
# En dispositivo físico usar la IP de tu PC en la red local (ej: 192.168.1.61).
EXPO_PUBLIC_GATEWAY_URL=http://10.0.2.2:5000
