{
  "expo": {
    "name": "SSIU Usuario",
    "slug": "ssiu-usuario",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ec.edu.uta.fisei.ssiu.user",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "La app necesita tu ubicación para enviar tu posición exacta al activar una alerta de pánico."
      }
    },
    "android": {
      "package": "ec.edu.uta.fisei.ssiu.user",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ],
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "port": 8081
    },
    "extra": {
      "gatewayUrl": "http://10.79.19.29:5000"
    }
  }
}
